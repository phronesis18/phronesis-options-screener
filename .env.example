# ============================================================
# OPTIONS SCREENER PHRONESIS — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos vraies valeurs
# ============================================================

# --- IBKR / TWS ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper
IBKR_CLIENT_ID=1

# --- DeepSeek (assistant IA) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (fallback si DeepSeek indisponible) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Sheets (optionnel) ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=

# --- Paramètres screener ---
MAX_RISK_PER_TRADE=120
LOG_LEVEL=INFO
